refresh-on-startup no
prepopulate-query-feeds yes
wrap-scroll yes
confirm-mark-feed-read no
browser "~/.config/newsboat/linkhandler.sh"
datetime-format "%b %d, %Y"
max-items 256
history-limit 0
cleanup-on-quit yes

delete-played-files yes
podlist-format "%4i [%-4p%%] %-12S %b"
download-filename-format "%t.%e"
download-path "~/Podboat/"
player "mpv --player-operation-mode=pseudo-gui -- %f"
